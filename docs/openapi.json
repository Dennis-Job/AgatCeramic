{
  "openapi": "3.1.1",
  "info": {
    "title": "AgatCeramic API",
    "version": "v1",
    "description": "Контракт публичного и административного API AgatCeramic. В спецификацию включаются только реализованные маршруты."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1"
    }
  ],
  "paths": {
    "/admin/auth/login": {
      "post": {
        "operationId": "loginAdmin",
        "summary": "Start an administrator session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Authenticated; the session cookie is set."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/admin/auth/me": {
      "get": {
        "operationId": "getCurrentAdmin",
        "summary": "Get the current administrator",
        "security": [{ "sanctumSession": [] }],
        "responses": {
          "200": {
            "description": "Current administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/admin/auth/logout": {
      "post": {
        "operationId": "logoutAdmin",
        "summary": "Invalidate the current administrator session",
        "security": [{ "sanctumSession": [] }],
        "responses": {
          "204": {
            "description": "Session invalidated."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "listAdminUsers",
        "summary": "List administrative users",
        "security": [{ "sanctumSession": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "blocked"] } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "Users", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserCollection" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "post": {
        "operationId": "createAdminUser",
        "summary": "Create an administrative user",
        "security": [{ "sanctumSession": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StoreAdminUserRequest" } } } },
        "responses": { "201": { "description": "Created user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationFailed" } }
      }
    },
    "/admin/users/roles": {
      "get": {
        "operationId": "listAssignableRoles",
        "summary": "List roles available for employee assignment",
        "security": [{ "sanctumSession": [] }],
        "responses": { "200": { "description": "Roles", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminRoleCollection" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/users/{user}": {
      "parameters": [{ "name": "user", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "operationId": "getAdminUser", "summary": "Get an administrative user", "security": [{ "sanctumSession": [] }], "responses": { "200": { "description": "User", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/BadRequest" } } },
      "patch": { "operationId": "updateAdminUser", "summary": "Update an administrative user", "security": [{ "sanctumSession": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAdminUserRequest" } } } }, "responses": { "200": { "description": "Updated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminUserResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationFailed" } } },
      "delete": { "operationId": "deleteAdminUser", "summary": "Delete an administrative user", "security": [{ "sanctumSession": [] }], "responses": { "204": { "description": "User deleted" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationFailed" } } }
    },
    "/admin/roles": {
      "get": { "operationId": "listRoles", "summary": "List roles", "security": [{ "sanctumSession": [] }], "responses": { "200": { "description": "Roles" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" } } },
      "post": { "operationId": "createRole", "summary": "Create custom role", "security": [{ "sanctumSession": [] }], "responses": { "201": { "description": "Created role" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationFailed" } } }
    },
    "/admin/roles/permissions": {
      "get": { "operationId": "listRolePermissions", "summary": "List permission catalogue for role editor", "security": [{ "sanctumSession": [] }], "responses": { "200": { "description": "Permissions" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/admin/roles/{role}": {
      "parameters": [{ "name": "role", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "operationId": "getRole", "summary": "Get role", "security": [{ "sanctumSession": [] }], "responses": { "200": { "description": "Role" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" } } },
      "patch": { "operationId": "updateRole", "summary": "Update role and permission assignments", "security": [{ "sanctumSession": [] }], "responses": { "200": { "description": "Updated role" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationFailed" } } },
      "delete": { "operationId": "deleteRole", "summary": "Delete custom role", "security": [{ "sanctumSession": [] }], "responses": { "204": { "description": "Role deleted" }, "401": { "$ref": "#/components/responses/Unauthenticated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationFailed" } } }
    },
    "/": {
      "get": {
        "operationId": "getApiVersion",
        "summary": "Получить версию API",
        "responses": {
          "200": {
            "description": "Версия API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                },
                "example": {
                  "version": "v1"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "AdminUser": {
        "type": "object",
        "required": ["id", "name", "email", "status", "last_login_at"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "status": { "type": "string", "enum": ["active", "blocked"] },
          "last_login_at": { "type": ["string", "null"], "format": "date-time" },
          "roles": { "type": "array", "items": { "$ref": "#/components/schemas/AdminRole" } }
        },
        "additionalProperties": false
      },
      "AdminUserResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/AdminUser" }
        },
        "additionalProperties": false
      },
      "AdminUserCollection": {
        "type": "object",
        "required": ["data", "links", "meta"],
        "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/AdminUser" } }, "links": { "type": "object" }, "meta": { "type": "object" } }
      },
      "AdminRole": {
        "type": "object",
        "required": ["id", "name", "slug"],
        "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "slug": { "type": "string" } },
        "additionalProperties": false
      },
      "AdminRoleCollection": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/AdminRole" } } }
      },
      "StoreAdminUserRequest": {
        "type": "object",
        "required": ["name", "email", "password", "password_confirmation", "status", "role_ids"],
        "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password", "minLength": 12 }, "password_confirmation": { "type": "string", "format": "password" }, "status": { "type": "string", "enum": ["active", "blocked"] }, "role_ids": { "type": "array", "minItems": 1, "items": { "type": "integer" } } },
        "additionalProperties": false
      },
      "UpdateAdminUserRequest": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password", "minLength": 12 }, "password_confirmation": { "type": "string", "format": "password" }, "status": { "type": "string", "enum": ["active", "blocked"] }, "role_ids": { "type": "array", "minItems": 1, "items": { "type": "integer" } } },
        "additionalProperties": false,
        "description": "All fields are optional; password_confirmation is required when password is supplied."
      },
      "VersionResponse": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "const": "v1"
          }
        },
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Стабильный машинный код ошибки."
              },
              "message": {
                "type": "string",
                "description": "Безопасное для отображения сообщение."
              },
              "details": {
                "type": "object",
                "description": "Ошибки полей для validation_failed; пустой объект для остальных ошибок.",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Authentication is required or the supplied credentials are invalid.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated administrator is blocked or does not have access.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "TooManyRequests": {
        "description": "Too many login attempts.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "BadRequest": {
        "description": "Некорректный запрос.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "Переданные данные не прошли проверку.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Непредвиденная ошибка; внутренние детали не раскрываются.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "sanctumSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "agatceramic-session",
        "description": "First obtain /sanctum/csrf-cookie with credentials, then send the X-XSRF-TOKEN header for state-changing requests."
      }
    }
  }
}
