{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run build",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:ci": "npm run lint && npm run format:check && npm run test:unit && npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8"
  }
}
